{
  "manifest_version": 3,
  "name": "求职投递台采集器",
  "version": "0.1.0",
  "description": "使用 AI 读取招聘页面，确认后添加到本地求职投递台。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.deepseek.com/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集投递草稿"
  }
}
